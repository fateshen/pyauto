# tasks/reward/xiuluomoyushengji.py
from tasks.reward.base import 强化奖励任务基类
from core.debug import 调试器
import time,random
from core.utils import 缩放区域

class 修罗魔域升级(强化奖励任务基类):
    任务ID = "xiuluomoyushengji"
    任务名称 = "修罗魔域升级"  
    是否启用: bool = True  
    最小间隔秒 = 3000
    最大间隔秒 =6000
   
    
    def 执行(self) -> bool:
        调试器.debug("强化奖励", "修罗血脉: 开始检查")
        if not self.打开修罗魔域页面():
            return False        
        self._血脉升级()
       
      
        return True
    def _血脉升级(self):

        右侧卡区域 = self.配置.区域.战场光翼图鉴页面右侧坐标池.位置3.元组
        if not self.辅助识别器.查找图片单结果(缩放区域(右侧卡区域, 1.6), "红点1.bmp"):
            调试器.debug("修罗魔域升级", "血脉升级：无红点，跳过")
            return
        if not self.页面.创建_通用点击区域验证文字切换(
            右侧卡区域,
            self.配置.区域.主界面.中间页面名称区域标签.元组,
            "血|脉"
        ).执行():
            调试器.debug("修罗魔域升级", "进血脉页面失败")
            return
        for _ in range(10):
            if not self.页面.创建寻图点击原区域验证图片切换(
                self.配置.区域.修罗魔域.修罗血脉页面升级按钮带红点区域标签.元组,
                "红点1.bmp",
                self.配置.区域.修罗魔域.修罗血脉页面升级按钮带红点区域标签.元组,
                "红点1.bmp",
                0.3
            ).执行():
                return
           
    def 打开修罗魔域页面(self) -> bool:       
        
        if not self.页面.主界面操作.展开右上角任务帘:
            调试器.debug("修罗魔域升级",  "展开右上角任务帘失败")
            return False

        if not self.页面.大千世界.进入大千世界页面():    
            调试器.debug("修罗魔域升级",  "进入大千世界页面失败")
            return False
        

        if not self.页面.大千世界.修罗魔域.进入修罗魔域任务页面():    
            调试器.debug("修罗魔域升级","进入修罗魔域任务页面失败")
            return False   
       
        调试器.state("修罗魔域升级", "已进入修罗魔域页面")
        return True   