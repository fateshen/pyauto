    def 执行入口逻辑(self) -> bool:
        """执行迷阵夺旗入口逻辑"""
        调试器.info(self.调试分类, "开始执行入口逻辑")
        
        # 1. 检查剩余次数
        if self.任务状态.剩余次数 <= 0:
            调试器.state(self.调试分类, f"今日次数已用完(剩余{self.任务状态.剩余次数})，跳过执行")
            return False
        
        if not self.页面.创建_通用点击图片验证文字切换(
            self.游戏配置.区域.主界面.第二三排任务区域标签.元组,
            "至尊联赛图标.bmp",
            self.游戏配置.区域.至尊联赛.迷阵夺旗进入按钮区域.元组,
            "进|入"
        ).执行():
            调试器.debug(self.调试分类, "进入迷阵夺旗页面失败，入口逻辑中断")
            return False
        
        if not self.页面.创建_通用点击文字验证文字切换(            
            self.游戏配置.区域.至尊联赛.迷阵夺旗进入按钮区域.元组,
            "进|入",
            self.游戏配置.区域.主界面.小地图地图名显示标签.元组,
            "迷阵|夺旗",
        ).执行():
            调试器.debug(self.调试分类, "进入迷阵夺旗页面失败，入口逻辑中断")
            return False
        
        调试器.state(self.调试分类, "入口逻辑执行成功，已进入迷阵夺旗副本")
        return True
    def 执行副本战斗逻辑(self) -> str:
        """
        执行副本战斗逻辑（模板方法）
        
        流程：
        1. 死亡复活 + 避让联动
        2. 更新战斗状态
        3. 位置复查（仅战斗前）
        4. 领取奖励退出
        5. 副本内检查钩子
        6. 正常阶段策略（回血）
        7. 抢怪阶段操作
        8. 退出条件检查
        9. 自动战斗/走位
        """
        调试器.debug(self.调试分类, "执行副本战斗逻辑")        
        
      
        # ========== 1. 死亡复活 + 避让联动 ==========
        if self.检查并处理复活( ):
            调试器.state(self.调试分类, f"死亡复活处理完成 (模式={'安全复活' if not 是否抢怪 else '原地复活'})")            
                       
            # 非抢怪阶段检查高频死亡避让
            if not 是否抢怪:
                if self._策略_高频死亡避让():
                    return "完成"            
            return "进行中"
        
        # ========== 2. 更新战斗状态 ==========  
        
        位置复查结果 = self._检查位置复查()
        if 位置复查结果 is not None:
            调试器.debug(self.调试分类, f"检查位置复查未通过：{位置复查结果}")
            return 位置复查结果

        # ========== 3. 战斗前钩子（战斗前的自定义内容） ==========
        战斗前结果=self._战斗前钩子()
        if 战斗前结果 is not None:
            调试器.debug(self.调试分类, f"战斗前钩子未通过：{战斗前结果}")
            return 战斗前结果
        
        # ========== 4. 领取奖励退出 ==========
        if self.通用操作.领取奖励退出操作():
            if self._领取奖励检查钩子() is not None:
                return "奖励领取处理完成"           
        
        # ========== 5. 副本内检查钩子 ==========
        
        结果 = self._副本内检查钩子()
        if 结果 is not None:
            return 结果
        
        # 6. 开战前避让检查
        结果 = self._开战前避让检查()
        if 结果 is not None:
            return 结果
        # ========== 6. 正常阶段策略 ==========
        if not 是否抢怪:
            if self._策略_回城回血():
                self.通用操作.点击回城石()
                return "进行中"
        
        # ========== 7. 抢怪阶段操作 ==========
        if 是否抢怪:
            self._执行抢怪操作()
        
        截图 = self.线程.截图
        self.更新目标状态()
        self.更新静止状态(截图)

        self.检查攻击模式()

        # ========== 8. 退出条件检查 ==========
        if self.检查退出条件():
            调试器.state(self.调试分类, "满足退出条件")
            if self.退出副本():
               调试器.info(self.调试分类, f"任务完成，剩余次数: {self.任务状态.剩余次数}")
            return "完成"
        
        # ========== 9. 自动战斗/走位 ==========
        if self.检查自动战斗走位前置条件():
            调试器.debug(self.调试分类, "刷新时间已到，执行自动战斗/走位")
            self.检查调整自动战斗状态()
            self.检查调整自动走位状态()
        # ============= 摇人动作 ==========        
        self._检查点击摇人按钮()

        return "进行中"
    